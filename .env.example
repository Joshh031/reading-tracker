# Server only. Never prefix these with VITE_. Configure only on the feature branch.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=familyhub-d72f8
FIRESTORE_DATABASE_ID=(default)
KV_ALLOWED_UIDS=
KV_LEGACY_OWNER_UID=
KV_STORAGE_RULES_VERIFIED=false
# Array of {hash: SHA256(token), uid: Firebase UID, scopes: [read,write], expiresAt: ISO}
KV_API_KEYS_JSON=[]
# Vercel OIDC is used automatically if available.
AI_GATEWAY_API_KEY=
KV_ANALYSIS_MODEL=openai/gpt-4.1-mini
ASSEMBLYAI_API_KEY=
KV_TRANSCRIPTION_ENABLED=false
KV_MAX_AUDIO_SECONDS=7200
KV_MAX_AUDIO_BYTES=250000000
KV_MAX_TRANSCRIPTIONS_PER_DAY=2
KV_MAX_ANALYSES_PER_DAY=10
KV_TRANSCRIPT_ADAPTER_URL=
KV_TRANSCRIPT_ADAPTER_KEY=
YOUTUBE_CAPTIONS_ACCESS_TOKEN=
# Explicit release gates; leave off throughout development.
KV_PRODUCTION_ENABLED=false
KV_DAILY_TRACKER_ENABLED=false
VITE_KV_LEGACY_WRITES=false

# Optional public web configuration for an isolated preview Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
